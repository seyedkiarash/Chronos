<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The only permissions the MVP needs. Both are runtime permissions on
         API 23+, so ask for them at the point the user presses "send to calendar",
         not on first launch. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!-- The Navigator's LLM layer is the only thing that goes online: one HTTPS call
         to the Anthropic API, only when you ask or a trigger fires. Everything
         else, including every plan and forecast, works offline. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Log reminders (asked for when you turn them on in the Log, never on first launch). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Chronos">
        <activity
            android:name="com.chronos.ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Chronos"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- A chat app's reply, shared back to the question waiting for it (copy and return). -->
            <intent-filter android:label="@string/share_to_navigator">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- The same from selected text: "Chronos" in the selection menu. -->
            <intent-filter android:label="@string/share_to_navigator">
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <!-- The quick answer typed into a log reminder. -->
        <receiver android:name="com.chronos.auto.QuickReplyReceiver" android:exported="false" />
    </application>

</manifest>
