    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#16344A"
        android:pathData="M0,0h108v108h-108z" />
    <!-- faint floor grid, gives the depth cue behind the axes -->
    <group
        android:scaleX="0.58"
        android:scaleY="0.58"
        android:translateX="25"
        android:translateY="25">
        <path
            android:strokeColor="#FFFFFF"
            android:strokeAlpha="0.10"
            android:strokeWidth="1.5"
            android:pathData="M14,84 L54,58 M36,88 L76,62 M58,92 L98,66 M14,84 L58,92 M34,71 L78,79 M54,58 L98,66" />
    </group>
</vector>
